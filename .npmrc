# npm hardening — defense-in-depth against supply-chain attacks.
#
# ignore-scripts: do NOT run package lifecycle scripts (preinstall/install/
#   postinstall/prepare) on install. This blocks the single most common npm
#   attack vector — a malicious dependency executing code during install.
#   Trade-off: husky's `prepare` no longer auto-runs; run `npm run prepare`
#   once (inside the container) after install to set up git hooks. Any native
#   dependency that genuinely needs a build step must be rebuilt EXPLICITLY and
#   allow-listed (there are none today).
ignore-scripts=true

# save-exact: pin exact versions when adding deps (no ^ / ~ ranges), so a
#   compromised patch release can't be pulled in silently on the next install.
save-exact=true

# engine-strict: fail install if the Node/npm version doesn't satisfy the
#   "engines" field, keeping everyone on a known-good toolchain (Node 24 LTS).
engine-strict=true
